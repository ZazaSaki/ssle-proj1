<!-- Threat 2 (Spam) — Wazuh rules. Append into the manager's local_rules.xml
     (or /var/ossec/etc/rules/spam_rules.xml). IDs in the 100200 block. -->
<group name="spam,spamassassin,">

  <rule id="100200" level="0">
    <decoded_as>spamd</decoded_as>
    <description>SpamAssassin spamd message (base)</description>
  </rule>

  <!-- Any message SpamAssassin flagged as spam -->
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <match>spamd: identified spam</match>
    <description>Spam detected by SpamAssassin (score $(sa_score)/$(sa_threshold)) for $(sa_user)</description>
    <group>spam,</group>
  </rule>

  <!-- High-confidence spam: very large score (e.g. GTUBE / obvious UBE) -->
  <rule id="100202" level="10">
    <if_sid>100201</if_sid>
    <field name="sa_score" type="pcre2">^\d{3,}\.</field>
    <description>High-confidence spam (score $(sa_score)) for $(sa_user)</description>
    <group>spam,attack,</group>
  </rule>

  <!-- Volume spam: many spam verdicts in a short window = a spam campaign.
       Keyed on the whole spam group so both 100201 and 100202 count. -->
  <rule id="100203" level="12" frequency="10" timeframe="60">
    <if_matched_group>spam</if_matched_group>
    <description>Spam campaign: 10+ spam messages in 60s (volume attack)</description>
    <group>spam,attack,dos,</group>
  </rule>

</group>
